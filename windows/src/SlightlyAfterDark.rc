#include <winres.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Slightly After Dark"
END

IDD_CONFIG DIALOGEX 0, 0, 264, 128
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Slightly After Dark Options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Screen saver:", -1, 10, 13, 60, 10
    COMBOBOX        IDC_SAVER, 74, 11, 180, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Object size:", -1, 10, 38, 60, 10
    CONTROL         "", IDC_OBJECT_SCALE, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 70, 34, 150, 18
    LTEXT           "100%", IDC_OBJECT_SCALE_VALUE, 224, 38, 30, 10

    LTEXT           "Motion speed:", -1, 10, 62, 60, 10
    CONTROL         "", IDC_PLAYBACK_SPEED, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 70, 58, 150, 18
    LTEXT           "100%", IDC_PLAYBACK_SPEED_VALUE, 224, 62, 30, 10

    AUTOCHECKBOX    "Show process memory usage", IDC_SHOW_MEMORY_USAGE, 10, 86, 200, 10

    DEFPUSHBUTTON   "OK", IDOK, 150, 106, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 204, 106, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION SAD_VERSION_MAJOR, SAD_VERSION_MINOR, SAD_VERSION_PATCH, 0
PRODUCTVERSION SAD_VERSION_MAJOR, SAD_VERSION_MINOR, SAD_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Slightly After Dark"
            VALUE "FileVersion", SAD_VERSION_STRING
            VALUE "ProductName", "Slightly After Dark"
            VALUE "ProductVersion", SAD_VERSION_STRING
            VALUE "OriginalFilename", "Slightly After Dark.scr"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
