# Generates the kSavers table from shared/savers.txt, the saver list the
# macOS build also uses.

set(SAD_SAVER_LIST "${SAD_SHARED_ROOT}/savers.txt")
if(NOT EXISTS "${SAD_SAVER_LIST}")
    message(FATAL_ERROR "Missing ${SAD_SAVER_LIST}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SAD_SAVER_LIST}")

file(STRINGS "${SAD_SAVER_LIST}" _sad_saver_lines ENCODING UTF-8)
set(_sad_savers "")
set(_sad_saver_count 0)
foreach(_sad_line IN LISTS _sad_saver_lines)
    if(_sad_line MATCHES "^[ \t]*(#|$)")
        continue()
    endif()
    if(NOT _sad_line MATCHES "^([a-z0-9-]+)[ \t]+(.+)$")
        message(FATAL_ERROR "Malformed line in ${SAD_SAVER_LIST}: ${_sad_line}")
    endif()
    set(_sad_filename "${CMAKE_MATCH_1}")
    string(STRIP "${CMAKE_MATCH_2}" _sad_title)
    if(NOT EXISTS "${SAD_ASSET_ROOT}/all/${_sad_filename}.html")
        message(FATAL_ERROR "${SAD_SAVER_LIST} lists ${_sad_filename}, but all/${_sad_filename}.html is missing")
    endif()
    string(REPLACE "\\" "\\\\" _sad_title "${_sad_title}")
    string(REPLACE "\"" "\\\"" _sad_title "${_sad_title}")
    string(APPEND _sad_savers "    {L\"${_sad_title}\", L\"${_sad_filename}\"},\n")
    math(EXPR _sad_saver_count "${_sad_saver_count} + 1")
endforeach()
if(_sad_saver_count EQUAL 0)
    message(FATAL_ERROR "${SAD_SAVER_LIST} lists no savers")
endif()

file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/savers.inc" CONTENT
"// Generated by Savers.cmake from shared/savers.txt. Do not edit.
inline constexpr std::array<SaverInfo, ${_sad_saver_count}> kSavers = {{
${_sad_savers}}};
" @ONLY)
