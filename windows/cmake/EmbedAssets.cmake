# Embeds the after-dark-css runtime assets and the shared presentation script
# into the screen saver as RCDATA resources, plus a path -> resource ID table.
#
# Like the macOS build, this refuses to produce a screen saver with missing
# assets instead of silently rendering a blank screen.

if(NOT EXISTS "${SAD_ASSET_ROOT}/all/base.css")
    message(FATAL_ERROR
        "${SAD_ASSET_ROOT} is not initialized. Run: git submodule update --init --recursive")
endif()

# Enforce the submodule revision recorded by the superproject, matching
# `make ensure-assets` on macOS. Source archives without git skip this check.
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${SAD_REPOSITORY_ROOT}/.git")
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${SAD_REPOSITORY_ROOT}" rev-parse HEAD:shared/after-dark-css
        OUTPUT_VARIABLE _sad_expected_revision
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _sad_expected_result
        ERROR_QUIET)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${SAD_ASSET_ROOT}" rev-parse HEAD
        OUTPUT_VARIABLE _sad_actual_revision
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _sad_actual_result
        ERROR_QUIET)
    if(_sad_expected_result EQUAL 0 AND _sad_actual_result EQUAL 0
       AND NOT _sad_actual_revision STREQUAL _sad_expected_revision)
        message(FATAL_ERROR
            "shared/after-dark-css is at ${_sad_actual_revision}, expected ${_sad_expected_revision}. "
            "Run: git submodule update --init --recursive")
    endif()
endif()

file(GLOB_RECURSE SAD_ASSET_FILES
    LIST_DIRECTORIES false
    RELATIVE "${SAD_ASSET_ROOT}"
    CONFIGURE_DEPENDS
    "${SAD_ASSET_ROOT}/all/*"
    "${SAD_ASSET_ROOT}/fonts/*"
    "${SAD_ASSET_ROOT}/img/*")
list(SORT SAD_ASSET_FILES)

# Every image, font, and stylesheet a page references must be embedded.
foreach(_sad_file IN LISTS SAD_ASSET_FILES)
    if(NOT _sad_file MATCHES "\\.(html|css)$")
        continue()
    endif()
    file(READ "${SAD_ASSET_ROOT}/${_sad_file}" _sad_content)
    get_filename_component(_sad_directory "${_sad_file}" DIRECTORY)
    string(REGEX MATCHALL "\\.\\./(img|fonts)/[A-Za-z0-9_.-]+" _sad_references "${_sad_content}")
    string(REGEX MATCHALL "href=\"[A-Za-z0-9_-]+\\.css\"" _sad_stylesheets "${_sad_content}")
    foreach(_sad_stylesheet IN LISTS _sad_stylesheets)
        string(REGEX REPLACE "href=\"(.*)\"" "${_sad_directory}/\\1" _sad_stylesheet "${_sad_stylesheet}")
        list(APPEND _sad_references "${_sad_stylesheet}")
    endforeach()
    foreach(_sad_reference IN LISTS _sad_references)
        string(REGEX REPLACE "^\\.\\./" "" _sad_reference "${_sad_reference}")
        if(NOT _sad_reference IN_LIST SAD_ASSET_FILES)
            message(FATAL_ERROR "Missing screen saver asset ${_sad_reference} referenced by ${_sad_file}")
        endif()
    endforeach()
endforeach()

set(_sad_presentation_script "${SAD_SHARED_ROOT}/page-presentation.js")
if(NOT EXISTS "${_sad_presentation_script}")
    message(FATAL_ERROR "Missing ${_sad_presentation_script}")
endif()

set(_sad_rc "// Generated by EmbedAssets.cmake. Do not edit.\n")
string(APPEND _sad_rc "#include \"resource.h\"\n")
string(APPEND _sad_rc "IDR_PAGE_PRESENTATION_SCRIPT RCDATA \"${_sad_presentation_script}\"\n")
set(_sad_table "// Generated by EmbedAssets.cmake. Do not edit.\n")
set(_sad_resource_id 1000)
set(SAD_ASSET_DEPENDENCIES "${_sad_presentation_script}")
foreach(_sad_file IN LISTS SAD_ASSET_FILES)
    math(EXPR _sad_resource_id "${_sad_resource_id} + 1")
    string(APPEND _sad_rc "${_sad_resource_id} RCDATA \"${SAD_ASSET_ROOT}/${_sad_file}\"\n")
    string(APPEND _sad_table "{L\"${_sad_file}\", ${_sad_resource_id}},\n")
    list(APPEND SAD_ASSET_DEPENDENCIES "${SAD_ASSET_ROOT}/${_sad_file}")
endforeach()

set(SAD_GENERATED_ASSET_RC "${CMAKE_CURRENT_BINARY_DIR}/generated/assets.rc")
file(CONFIGURE OUTPUT "${SAD_GENERATED_ASSET_RC}" CONTENT "${_sad_rc}" @ONLY)
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/asset_table.inc" CONTENT "${_sad_table}" @ONLY)

# Asset edits should relink the resources without a reconfigure.
set_source_files_properties("${SAD_GENERATED_ASSET_RC}" PROPERTIES
    OBJECT_DEPENDS "${SAD_ASSET_DEPENDENCIES}")

list(LENGTH SAD_ASSET_FILES _sad_asset_count)
message(STATUS "Embedding ${_sad_asset_count} screen saver assets from ${SAD_ASSET_ROOT}")
